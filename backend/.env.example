# Supabase connection
SUPABASE_URL=https://your-project-ref.supabase.co
# MUST be the "service_role" secret (Settings → API), NOT the anon key — otherwise RLS blocks writes.
SUPABASE_SERVICE_KEY=your-service-role-secret-jwt

# Google AI / Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# RAG configuration: `local` = API tag local_gemini; `gemini` = tag gemini; `simple` = keyword-only retrieval. All use the same Google Gemini when GEMINI_API_KEY is set.
RAG_MODE=gemini
RAG_DEBUG=1
RAG_CACHE_TTL_SECONDS=90
