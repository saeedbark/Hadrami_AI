# Supabase connection
SUPABASE_URL=https://your-project-ref.supabase.co
# MUST be the "service_role" secret (Settings → API), NOT the anon key — otherwise RLS blocks writes.
SUPABASE_SERVICE_KEY=your-service-role-secret-jwt

# Google AI / Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# RAG configuration
RAG_MODE=local
RAG_DEBUG=1
RAG_CACHE_TTL_SECONDS=90
